# Required for every deployment. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Production URL with no trailing slash, e.g. https://onenotequeue.example.com
APP_URL=http://localhost:3000
# Neon/Supabase/Postgres connection string. Required outside demo mode.
# For Docker Compose, replace the password below and set the same value in POSTGRES_PASSWORD.
DATABASE_URL=postgresql://onenote_queue:CHANGE_ME@postgres:5432/onenote_queue
# Used by the bundled PostgreSQL container. Generate a long random password.
POSTGRES_PASSWORD=CHANGE_ME
# Optional: set to a random 32+ character value to enable Vercel cron sync.
CRON_SECRET=
